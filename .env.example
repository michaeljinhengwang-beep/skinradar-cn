# 本地开发通常无需设置，未设置时安全回退到 http://localhost:3000。
# Vercel 部署后请填写已确认的正式域名，并重新部署。
# 不要在此文件中放置 API key、Token 或任何秘密；.env.local 不应提交 Git。
NEXT_PUBLIC_SITE_URL=https://example.com

# 市场数据 Provider 默认保持 mock；仅在服务端技术验证时显式改为 csfloat。
MARKET_DATA_PROVIDER=mock

# 仅服务器端使用的 secret。不得填写真实值后提交；本地值放入 .env.local，
# Vercel 部署使用 Environment Variables，且不得添加 NEXT_PUBLIC_ 前缀。
CSFLOAT_API_KEY=

# 服务器端市场缓存 TTL，单位为秒；缺失或非法时安全回退到 300。
MARKET_CACHE_TTL_SECONDS=300

# 仅服务器端持久化 Repository 使用；真实值放入 .env.local 或 Vercel。
# 新项目优先使用 Supabase secret API key；绝对不得添加 NEXT_PUBLIC_ 前缀。
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Legacy compatibility only：仅兼容旧项目的 service_role key。
SUPABASE_SERVICE_ROLE_KEY=

# 仅服务器端同步锁使用；超过 900 秒的 running 任务可标记失败后安全回收。
MARKET_SYNC_LOCK_TIMEOUT_SECONDS=900

# 内部同步单次最大运行时间，单位为秒；缺失、非整数、非正数或超过 300 时回退到 60。
MARKET_SYNC_MAX_RUN_SECONDS=60

# 未来生产市场数据的新鲜度阈值，单位为秒；当前页面仍使用 mock，不读取此配置。
MARKET_DATA_STALE_AFTER_SECONDS=1800

# 仅服务器端内部同步入口使用；真实值不得提交，也不得添加 NEXT_PUBLIC_ 前缀。
CRON_SECRET=

# 内部市场同步安全门：首次部署必须保持 false；非法值同样视为 false。
MARKET_SYNC_ENABLED=false

# Phase 11 仍仅允许 mock；任何其他值（包括 csfloat）都会被内部入口拒绝。
MARKET_SYNC_PROVIDER=mock
